# 颐智康养 v0.3 环境配置
# 复制此文件为 backend/.env 并修改

# ===== 数据库 =====
# 开发模式（SQLite，默认，无需配置）：
#   不设置任何 DB_* 变量
#   自动使用 backend/yzkang_v2.db
#
# 生产模式（PostgreSQL）：
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=yzkang
# DB_PASSWORD=your_password_here
# DB_NAME=yzkang_v2

# 或直接用 DATABASE_URL 覆盖所有 DB_* 变量
# DATABASE_URL=postgresql://yzkang:password@localhost:5432/yzkang_v2

# ===== 连接池（仅 PostgreSQL 生效）=====
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=3600

# ===== 安全 =====
# SECRET_KEY=change-this-to-a-random-string-in-production
# ENCRYPTION_KEY=32-byte-base64-encoded-key-for-aes-256-gcm

# ===== JWT =====
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 限流 =====
# RATE_LIMIT_MAX_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# ===== 腾讯云短信 =====
# TENCENT_SMS_SECRET_ID=your_secret_id
# TENCENT_SMS_SECRET_KEY=your_secret_key
# TENCENT_SMS_SDK_APP_ID=your_app_id
# TENCENT_SMS_SIGN_NAME=颐智康养
# TENCENT_SMS_TEMPLATE_ALERT=your_template_id

# ===== 日志 =====
# LOG_LEVEL=INFO
# LOG_JSON=true     # 是否输出 JSON 格式（默认 true）

# ===== 错误追踪 (Sentry) =====
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== 监控 (Prometheus) =====
# 指标端点: GET /metrics
# 已在应用内自动启用，无需配置
