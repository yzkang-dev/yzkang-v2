# ==================== 颐智康养 — 生产环境变量模板 ====================
# 复制此文件为 .env 并填写实际值
# cp .env.production.example .env

# ── 数据库 ─────────────────────────────────────
DB_USER=yzkang
DB_PASSWORD=请生成强密码
DB_NAME=yzkang_v2

# ── 安全 ───────────────────────────────────────
SECRET_KEY=请生成随机字符串(openssl rand -hex 32)
ENCRYPTION_KEY=请生成随机字符串(openssl rand -hex 32)

# ── 限流 ───────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60

# ── 监控 ───────────────────────────────────────
SENTRY_DSN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=请生成强密码
GRAFANA_ROOT_URL=https://你的域名/grafana

# ── 邮件服务 (可选) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yzkang.com

# ── 端口 ───────────────────────────────────────
FRONTEND_PORT=80
GRAFANA_PORT=3000

# ── Docker 镜像 ─────────────────────────────────
GITHUB_REPO=your-org/yzkang
