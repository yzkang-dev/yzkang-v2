# 颐智康养 Docker 环境变量
# 复制此文件为 .env 并修改（可选，不修改则使用默认值）

# ===== PostgreSQL =====
DB_USER=yzkang
DB_PASSWORD=yzkang_dev_pwd
DB_NAME=yzkang_v2

# ===== 后端安全 =====
# 生产环境务必修改！
SECRET_KEY=yzkang-docker-secret-change-me

# AES-256-GCM 加密密钥（32字节 base64，留空则从 SECRET_KEY 派生）
# ENCRYPTION_KEY=

# ===== 限流 =====
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
